%% sub-preprocessor - processing pipeline
%% ONE ordered `filters:` list feeds two stages:
%%   IP-stage      = country/asn, per node by IP, on / and the worker
%%   through-node  = gemini/claude/chatgpt/tidal/bandwidth, worker only
flowchart TD
  %% ================= Crawler =================
  subgraph CRAWLER["tg-sub-crawler - CRAWL_INTERVAL (30m) or daily CRAWL_AT"]
    direction TB
    CH["channels.yaml - seed channels"]
    SCAN["scan - relevance-gated BFS over t.me reposts"]
    CLS["classify - fetch link, is it a live subscription?"]
    STATE["crawler-state.json - productive channels become seeds"]
    CH --> SCAN --> CLS
    CLS -->|live subscription| PRIV["private.yaml - tg-CHANNEL-HASH sources"]
    CLS -->|raw URIs in messages| PRIV
    CLS -->|productive channel| STATE
    STATE -. seeds .-> SCAN
  end

  %% ================= Source set =================
  CFG["config.yaml + sources.yaml - subscriptions.sources"]
  SRC(["source set - url sources + inline tg-inline body"])
  CFG --> SRC
  PRIV --> SRC
  PRIV -. hot-reload .-> SRC

  %% ================= IP-stage filters (shared by both paths) =================
  subgraph FILTER["svc.Filter - IP-stage, per node, by IP - shared by / and worker"]
    direction TB
    GBH["geoblock skip - node host in blocklist? (pre-DNS)"]
    RES["DNS resolve host to IPs - TTL cached"]
    IPF["filters: country (provider geofeed|asn) / asn (deny_patterns)"]
    ANN["annotate: - prepend GEO tags to the node name"]
    GBH --> RES --> IPF --> ANN
  end

  %% ================= On-demand path (/) =================
  REQ["GET / - subscription_url + countries/groups"] --> FILTER
  FILTER -->|on-demand| OUT1["/ response - text/plain, annotated, no probing"]

  %% ================= Stable worker =================
  subgraph WORKER["stable worker - every subscriptions.interval (1h)"]
    direction TB
    MERGE["Merge - dedup by server:port, relabel src-NNN (Raw=probe label / Tagged=output)"]
    DEAD["dead-skip - server:port in dead cache?"]
    LAT["latency probe - mihomo URLTest, rounds=2, concurrency=16, timeout=1000ms"]
    SEL["SelectSurvivors - max_fail=1, max_avg_ms=800"]
    GEM["gemini - GET generativelanguage through the node, scan body for the block marker (needs a key)"]
    CLA["claude - keyless GET api.anthropic.com/v1/models, scan body"]
    CGP["chatgpt - keyless GET api.openai.com/compliance/cookie_requirements, scan body"]
    TDL["tidal - keyless GET api.tidal.com/v1/country, fail-closed: keep only 2xx with a readable countryCode (refused egress = CloudFront 403, no JSON)"]
    BWD["bandwidth - download test_url through the node, drop below min_mbps (last: fewest nodes)"]
    PUBL["GET /stable.txt - Tagged names (GEO/SPD tags + src-NNN)"]
    MERGE --> DEAD --> LAT --> SEL --> GEM --> CLA --> CGP --> TDL --> BWD --> PUBL
  end
  SRC --> FILTER
  FILTER -->|worker| MERGE

  %% ================= Stores =================
  GEODB[("geoblock.db - SQLite, geoblock.ttl 30d, key=host")]
  DEADSET[("dead set - in-memory, deadcache.ttl 2h, key=server:port")]
  GEM -->|blocked host| GEODB
  CLA -->|blocked host| GEODB
  CGP -->|blocked host| GEODB
  %% tidal writes nothing: its verdict is a bare status code, too weak a signal
  %% to persist host-wide for the store's TTL.
  GEODB -. read .-> GBH
  LAT -->|no success = dead| DEADSET
  DEADSET -. read .-> DEAD
