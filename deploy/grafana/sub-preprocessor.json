{
  "uid": "sub-preprocessor",
  "title": "sub-preprocessor",
  "tags": [
    "sub-preprocessor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kept nodes (last cycle)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_kept_nodes"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Merged nodes (last cycle)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_merged_nodes"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sources OK / total",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_sources_ok",
          "legendFormat": "ok"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_sources_total",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last cycle age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4000
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - stable_last_success_timestamp_seconds"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pipeline funnel (merged -> probed -> kept)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_merged_nodes",
          "legendFormat": "merged"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_probed_nodes",
          "legendFormat": "probed"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_dead_skipped_nodes",
          "legendFormat": "dead-skipped"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_kept_nodes",
          "legendFormat": "kept"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Through-node filters: in vs kept",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_filter_in_nodes",
          "legendFormat": "{{filter}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_filter_kept_nodes",
          "legendFormat": "{{filter}} kept"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Through-node filter drops by reason",
      "description": "blocked = the service answered but refused this egress; unreachable = the request never completed through the node (it still passed the latency probe, so this is the service refusing at the CDN or the node failing on real traffic); slow = below the bandwidth filter minimum.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_filter_dropped_nodes",
          "legendFormat": "{{filter}}/{{reason}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top sources by kept nodes (last cycle)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "kept",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(25, stable_source_kept_nodes)",
          "legendFormat": "{{source}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "source"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "kept"
            }
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Gemini gate: is it verifying?",
      "description": "Whether the gemini gate ran at all last cycle. OFF means it is configured as a filter but has no usable API key, so it checked NOTHING and passed every survivor through unverified — on the two filter panels above that gate then looks like one that simply found nobody to drop, which is the failure this panel exists to expose. No data does NOT mean “not configured” on its own — it has four causes: nothing scraped yet, no cycle published yet, no gemini filter in the filters list, or one configured that never reached its check (the prober has no Gemini support and buildNodeFilters skipped it with only a WARN, or ParseProxies failed and the whole through-node chain was skipped, publishing every survivor UNFILTERED). Only the first two are benign. The gate's verdict is invisible without a working credential: the API answers caller identity, then key validity, and only then the location precondition this gate reads.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NOT RUNNING",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF — no usable key",
                  "index": 0
                },
                "1": {
                  "text": "VERIFYING",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NOT RUNNING",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_gemini_gate_enabled"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Gemini gate: share it could not verify",
      "description": "Of the Gemini API responses the gate classified last cycle, the share that told it nothing about the egress location — the API rejected the request before evaluating it (401/403/404/429, or 400 API_KEY_INVALID: a rotated, restricted or quota-exhausted key). Those nodes were KEPT and published unverified, so this is gate health, not a drop rate. The denominator is the gate's own classified-response count, not stable_filter_in_nodes: only a proxy that ANSWERED reaches the classifier, so a proxy that never answered is in neither term — and it reaches reason=\"unreachable\" on the drops panel only when EVERY proxy of its node was unreachable, since that reason is counted per surviving NODE off an outcome already folded best-of-ports: one live port keeps the node and its dead siblings are counted nowhere. Empty when the gate classified nothing — read the panel to the left for why.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 20
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "gate classified nothing",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_gemini_gate_unverified_checks / (stable_gemini_gate_checks > 0)"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Gemini gate: verified vs unverified (the unverified are all KEPT)",
      "description": "The gate's classified responses split by whether a location verdict came back. The unverified series is never a drop — those nodes are published exactly like one the gate cleared, which is why it cannot ride the drops panel above. The verified series is NOT all kept: a verified response carrying the geo-block marker drops its node, and that one does show up above as reason=\"blocked\". The two series sum to stable_gemini_gate_checks. One response per proxy that ANSWERED, so a mierus:// node contributes one per answering port — not one per configured port, and not one per node.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "unverified (kept, gate learned nothing)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "verified (a location verdict came back)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_gemini_gate_checks - stable_gemini_gate_unverified_checks",
          "legendFormat": "verified (a location verdict came back)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_gemini_gate_unverified_checks",
          "legendFormat": "unverified (kept, gate learned nothing)"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "cloudflare egress (annotation, not a gate)",
      "description": "What the published nodes reported about themselves through cloudflare cdn-cgi/trace. Nothing here is a drop: a trace that fails, or contradicts the offline chain, still publishes the node. answered/unanswered split the survivors by whether the trace completed — a large unanswered share makes the moved ratio below it that much less representative. moved = answered nodes whose final country differs from what the offline chain placed the resolved address in, i.e. how often the tag would have been wrong without the trace (measured: 47 of 102). It is a property of the pool, not a fault: an anycast front-end registers in one country and exits in another.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_trace_answered_nodes",
          "legendFormat": "answered"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_trace_unanswered_nodes",
          "legendFormat": "unanswered"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_trace_moved_nodes",
          "legendFormat": "moved (offline chain was wrong)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Kept-node speed (Mbps): min / p50 / avg / p90 / max",
      "description": "p50/p90 are interpolated from 7 fixed buckets (5-500 Mbps); a quantile landing above the top bucket reports 500, so p90 pinned at 500 under a higher max means \"faster than 500\", not a plateau. min/max are exact per-cycle values. The whole panel is empty unless a bandwidth filter runs: without one no node has a measured speed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (stable_kept_speed_mbps_bucket))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (stable_kept_speed_mbps_bucket))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_kept_speed_min_mbps",
          "legendFormat": "min"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_kept_speed_max_mbps",
          "legendFormat": "max"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_kept_speed_mbps_sum / clamp_min(stable_kept_speed_mbps_count, 1)",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cycle duration & failures",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failures/h"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cycles/h"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_cycle_duration_seconds",
          "legendFormat": "duration"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(stable_cycle_failures_total[1h])",
          "legendFormat": "failures/h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(stable_cycles_total[1h])",
          "legendFormat": "cycles/h"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GEO coverage: unresolved [GEO:??] in published list",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% of kept"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "stable_geo_unknown_nodes",
          "legendFormat": "unresolved nodes"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * stable_geo_unknown_nodes / clamp_min(stable_kept_nodes, 1)",
          "legendFormat": "% of kept"
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Top countries in published list (last cycle)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(15, stable_kept_country_nodes)",
          "legendFormat": "{{country}}",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "IP-stage filter drops by reason (preprocess, both endpoints)",
      "description": "Per-node filters that run before probing: DNS resolution failure, country allow-list, ASN deny-patterns, and the geoblock store populated by the through-node gemini/claude/chatgpt checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (stable_source_dropped_nodes)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Preprocess yield: nodes fetched vs surviving the IP-stage filters",
      "description": "Raw nodes all sources yielded versus what reached the merge step. The gap is everything the IP-stage filters dropped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% kept"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(stable_source_nodes_total)",
          "legendFormat": "fetched"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(stable_source_kept_nodes)",
          "legendFormat": "survived IP-stage"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum(stable_source_kept_nodes) / clamp_min(sum(stable_source_nodes_total), 1)",
          "legendFormat": "% kept"
        }
      ]
    }
  ]
}
